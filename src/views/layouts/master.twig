{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ user.language.code }}" dir="{{ user.language.dir }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = {{ theme.settings.get('enable_add_product_toast', true) | json_encode }}
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
{#
  HDL-03 preset resolution — one centralized, allowlisted resolver, kept inline
  in this layout on purpose: Salla server rendering does not package a new
  top-level src/views/partials/ directory (owner-confirmed draft 1402312628
  rendered "File [src/views/partials/preset-classes.twig] Not Found"), while
  layouts/master.twig is a proven packaged path. Do not extract this block
  back into a new partial location without live-preview proof.

  Contract: specs/003-settings-preset-engine/contracts/preset-resolution.md
  Reference: tests/helpers/settings-preset-engine.mjs (must produce identical
  outcomes; the maps below are pinned to src/config/settings-registry.json by
  the "shipped Twig resolver maps match the canonical registry" test).

  Rules honored here:
  - Engine disabled (or unset/null before first save, per the migration Spike)
    reproduces the exact legacy classes from the six legacy settings.
  - The six legacy IDs are the persistent Custom stores; this resolver only
    reads settings and never calls theme.settings.set().
  - Every emitted class is prefix + an allowlisted value. Raw merchant input
    is never concatenated into a class.
  - Unknown/unset profile normalizes to `modern` with a needs_review marker;
    unknown/unset mode marks needs_review, preserving a valid Custom value
    first. Empty IS NOT a valid declared default once the engine is on.
#}
{% set hadeel_allowed = {"layout_width":["compact","wide","full"],"section_spacing":["compact","balanced","spacious"],"corner_style":["square","soft","rounded"],"product_card_style":["minimal","bordered","elevated"],"header_layout":["centered","start"],"header_density":["compact","comfortable"]} %}
{% set hadeel_safe = {"layout_width":"wide","section_spacing":"balanced","corner_style":"square","product_card_style":"minimal","header_layout":"centered","header_density":"comfortable"} %}
{% set hadeel_profiles = {"luxury":{"layout_width":"wide","section_spacing":"spacious","corner_style":"rounded","product_card_style":"elevated","header_layout":"centered","header_density":"comfortable"},"modern":{"layout_width":"wide","section_spacing":"balanced","corner_style":"square","product_card_style":"minimal","header_layout":"centered","header_density":"comfortable"},"minimal":{"layout_width":"wide","section_spacing":"spacious","corner_style":"square","product_card_style":"minimal","header_layout":"centered","header_density":"comfortable"},"practical_digital":{"layout_width":"compact","section_spacing":"compact","corner_style":"soft","product_card_style":"bordered","header_layout":"start","header_density":"compact"}} %}
{% set hadeel_engine_raw = theme.settings.get('preset_engine_enabled', false) %}
{% set hadeel_engine_on = hadeel_engine_raw in [true, 'true', 1, '1'] %}
{% set hadeel_profile_raw = theme.settings.get('preset_profile') %}
{% set hadeel_profile = hadeel_profile_raw in hadeel_profiles|keys ? hadeel_profile_raw : 'modern' %}
{% set hadeel_profile_review = hadeel_engine_on and hadeel_profile_raw not in hadeel_profiles|keys %}
{% set hadeel_resolved = {} %}
{% set hadeel_sources = {} %}
{% set hadeel_review = hadeel_profile_review ? ['preset_profile'] : [] %}
{% for hadeel_id in hadeel_allowed|keys %}
  {% set hadeel_stored = theme.settings.get(hadeel_id, hadeel_safe[hadeel_id]) %}
  {% set hadeel_value = null %}
  {% set hadeel_from = null %}
  {% set hadeel_flag = false %}
  {% if not hadeel_engine_on %}
    {# Contract step 1: legacy value if allowlisted, else safe default + review. #}
    {% if hadeel_stored in hadeel_allowed[hadeel_id] %}
      {% set hadeel_value = hadeel_stored %}
      {% set hadeel_from = 'legacy' %}
    {% else %}
      {% set hadeel_value = hadeel_safe[hadeel_id] %}
      {% set hadeel_from = 'safe_default' %}
      {% set hadeel_flag = true %}
    {% endif %}
  {% else %}
    {% set hadeel_mode = theme.settings.get(hadeel_id ~ '_mode') %}
    {% set hadeel_custom_ok = hadeel_stored in hadeel_allowed[hadeel_id] %}
    {% set hadeel_map_value = hadeel_profiles[hadeel_profile][hadeel_id] %}
    {% set hadeel_map_ok = hadeel_map_value in hadeel_allowed[hadeel_id] %}
    {% if hadeel_mode == 'custom' and hadeel_custom_ok %}
      {# Contract step 4: valid Custom wins. #}
      {% set hadeel_value = hadeel_stored %}
      {% set hadeel_from = 'custom' %}
      {% set hadeel_flag = hadeel_profile_review %}
    {% elseif hadeel_mode == 'custom' %}
      {# Contract step 5: invalid Custom -> review, then normalized profile. #}
      {% set hadeel_flag = true %}
    {% elseif hadeel_mode == 'follow_preset' %}
      {# Contract step 6: normalized profile value. #}
      {% set hadeel_flag = hadeel_profile_review %}
    {% else %}
      {# Contract step 3: unknown/unset mode -> review; valid Custom preserved first. #}
      {% set hadeel_flag = true %}
      {% if hadeel_custom_ok %}
        {% set hadeel_value = hadeel_stored %}
        {% set hadeel_from = 'custom' %}
      {% endif %}
    {% endif %}
    {% if hadeel_value is null %}
      {% if hadeel_map_ok %}
        {% set hadeel_value = hadeel_map_value %}
        {% set hadeel_from = 'preset' %}
      {% else %}
        {# Contract step 7: missing/invalid profile candidate -> safe default + review. #}
        {% set hadeel_value = hadeel_safe[hadeel_id] %}
        {% set hadeel_from = 'safe_default' %}
        {% set hadeel_flag = true %}
      {% endif %}
    {% endif %}
  {% endif %}
  {% if hadeel_flag %}
    {% set hadeel_review = hadeel_review|merge([hadeel_id]) %}
  {% endif %}
  {% set hadeel_resolved = hadeel_resolved|merge({(hadeel_id): hadeel_value}) %}
  {% set hadeel_sources = hadeel_sources|merge({(hadeel_id): hadeel_from}) %}
{% endfor %}
{% set hadeel_sources_list = [] %}
{% for hadeel_id in hadeel_allowed|keys %}
  {% set hadeel_sources_list = hadeel_sources_list|merge([hadeel_id ~ ':' ~ hadeel_sources[hadeel_id]]) %}
{% endfor %}
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('use_theme_font', false) ? ' use-theme-font' : '' }}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  hadeel-layout-{{ hadeel_resolved.layout_width }}
  hadeel-spacing-{{ hadeel_resolved.section_spacing }}
  hadeel-corners-{{ hadeel_resolved.corner_style }}
  hadeel-card-{{ hadeel_resolved.product_card_style }}
  hadeel-header-{{ hadeel_resolved.header_layout }}
  hadeel-header-density-{{ hadeel_resolved.header_density }}
  {{ hadeel_engine_on ? ' hadeel-preset-' ~ hadeel_profile : '' }}
  {{ page.slug == 'product.single' ? ' product-single-page' : '' }}
  "{% if hadeel_engine_on %} data-hadeel-preset="{{ hadeel_profile }}" data-hadeel-preset-sources="{{ hadeel_sources_list|join(',') }}"{% endif %}{% if hadeel_review|length > 0 %} data-hadeel-preset-review="{{ hadeel_review|join(',') }}"{% endif %}>
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
{#
  Product cards are rendered client-side, while custom theme locale keys are reliably
  resolved by Twilight's server-side `trans()` helper. Keep their copy in the locale
  files and expose the resolved values without painting extra markup on the page.
#}
<template id="hadeel-product-card-i18n"
          data-quick-view="{{ trans('pages.products.kalles.quick_view') }}"
          data-quick-add="{{ trans('pages.products.kalles.quick_add') }}"
          data-view-details="{{ trans('pages.products.kalles.view_details') }}"
          data-add-to-wishlist="{{ trans('pages.products.kalles.add_to_wishlist') }}">
</template>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main">
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    {# The setting id is retained for backwards compatibility with saved merchant choices. #}
    <salla-hadeel-cart-drawer
        data-text-title="{{ trans('pages.cart.drawer_title') }}"
        data-text-close="{{ trans('pages.cart.close_drawer') }}"
        data-text-remove="{{ trans('pages.cart.remove_item') }}"
        data-text-note="{{ trans('pages.cart.item_note') }}"
        data-text-note-placeholder="{{ trans('pages.cart.item_note_placeholder') }}"
        data-text-shipping-tax-notice="{{ trans('pages.cart.shipping_tax_notice') }}"
        data-text-view-cart="{{ trans('pages.cart.view_cart') }}"
        data-text-load-error="{{ trans('pages.cart.drawer_load_error') }}"
        data-text-retry="{{ trans('pages.cart.retry') }}">
    </salla-hadeel-cart-drawer>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal></salla-offer-modal>
<salla-search></salla-search>

{% if user.type=='guest' %}
    <salla-login-modal></salla-login-modal>
{% endif %}
{% if store.scope %}
    <salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
