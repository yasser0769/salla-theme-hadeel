<footer class="store-footer">
  <div aria-label="{{ trans('blocks.footer.landmark') }}" class="store-footer__inner">
    <div class="container store-footer__grid">
      <section class="store-footer__about">
        <a href="{{ link('/') }}" class="store-footer__brand">{{ store.name }}</a>
        {% if theme.settings.get('footer_show_description', true) and store.description %}
          <div class="store-footer__description">{{ store.description|raw }}</div>
        {% endif %}
        {% if theme.settings.get('footer_show_social', true) %}
          <salla-social class="store-footer__social"></salla-social>
        {% endif %}
      </section>

      <section class="store-footer__links">
        <h3>{{ trans('blocks.footer.pages_links') }}</h3>
        <salla-menu source="footer"></salla-menu>
      </section>

      {% if theme.settings.get('footer_show_contacts', true) %}
        <section class="store-footer__contact">
          <h3>{{ trans('blocks.footer.contact') }}</h3>
          <salla-contacts></salla-contacts>
        </section>
      {% endif %}

      <section class="store-footer__trust">
        <h3>{{ trans('blocks.footer.trust') }}</h3>
        <salla-trust-badges {% if theme.settings.get('footer_is_dark') %} dark {% endif %}></salla-trust-badges>

        {% if store.settings.tax.number %}
          <div class="store-footer__tax">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="{{ trans('common.elements.tax_number') }}">
                <img width="40" height="50" src="{{ 'images/tax.png' | cdn(70,70) }}" loading="lazy" alt="{{ trans('common.elements.tax_number') }}">
              </a>
            {% endif %}
            <div>
              <p>{{ trans('common.elements.tax_number') }}</p>
              <b>{{ store.settings.tax.number }}</b>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}">
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </section>

      <salla-apps-icons class="store-footer__apps"></salla-apps-icons>
    </div>
  </div>

  <div class="container store-footer__bottom">
    <span class="copyright-text">{% hook copyright %}</span>
    {% if theme.settings.get('footer_show_payments', true) %}
      <salla-payments></salla-payments>
    {% endif %}
  </div>
</footer>

{#
  Kalles 5.4.2 mobile toolbar proportions, wired to native Salla routes/events.
  Kept inside the registered footer component so Twilight does not need to resolve
  an extra structural component at runtime.
#}
{% if theme.settings.get('show_mobile_toolbar', true) %}
<nav class="mobile-toolbar" aria-label="{{ trans('blocks.footer.quick_navigation') }}">
  <a
    class="mobile-toolbar__item {{ is_page('index') ? 'is-active' : '' }}"
    href="{{ link('/') }}"
    aria-label="{{ trans('blocks.footer.store') }}">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>{{ trans('blocks.footer.store') }}</span>
  </a>

  <button
    class="mobile-toolbar__item"
    type="button"
    aria-label="{{ trans('blocks.footer.search') }}"
    onclick="salla.event.dispatch('search::open')">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>{{ trans('blocks.footer.search') }}</span>
  </button>

  <a
    class="mobile-toolbar__item mobile-toolbar__cart {{ page.slug == 'cart' ? 'is-active' : '' }}"
    href="{{ link('cart') }}"
    aria-label="{{ trans('blocks.footer.cart') }}">
    <span class="mobile-toolbar__icon">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39A2 2 0 0 0 9.68 16h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <b class="mobile-toolbar__count" data-cart-count>{{ cart.items_count }}</b>
    </span>
    <span>{{ trans('blocks.footer.cart') }}</span>
  </a>

  {% if user.type == 'user' %}
    <a
      class="mobile-toolbar__item {{ page.slug == 'customer.profile' or page.slug == 'profile' or page.slug == 'customer.orders' ? 'is-active' : '' }}"
      href="{{ link('profile') }}"
      aria-label="{{ trans('blocks.footer.account') }}">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>{{ trans('blocks.footer.account') }}</span>
    </a>
  {% else %}
    <button
      class="mobile-toolbar__item"
      type="button"
      aria-label="{{ trans('blocks.footer.login') }}"
      onclick="salla.event.dispatch('login::open')">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>{{ trans('blocks.footer.account') }}</span>
    </button>
  {% endif %}

</nav>
{% endif %}
