{#
  Kalles 5.4.2 mobile toolbar proportions, wired to native Salla routes/events.
  The icon paths are the same Feather-outline shapes used by the reference toolbar.
#}
<nav class="mobile-toolbar" aria-label="التنقل السريع">
  <a
    class="mobile-toolbar__item {{ is_page('index') ? 'is-active' : '' }}"
    href="{{ link('/') }}"
    aria-label="المتجر">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>المتجر</span>
  </a>

  <a
    class="mobile-toolbar__item {{ page.slug in ['wishlist', 'customer.wishlist'] ? 'is-active' : '' }}"
    href="{{ link('wishlist') }}"
    aria-label="المفضلة">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <span>المفضلة</span>
  </a>

  <a
    class="mobile-toolbar__item mobile-toolbar__cart {{ page.slug == 'cart' ? 'is-active' : '' }}"
    href="{{ link('cart') }}"
    aria-label="السلة">
    <span class="mobile-toolbar__icon">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39A2 2 0 0 0 9.68 16h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <b class="mobile-toolbar__count" data-cart-count>{{ cart.items_count }}</b>
    </span>
    <span>السلة</span>
  </a>

  {% if user.type == 'user' %}
    <a
      class="mobile-toolbar__item {{ page.slug starts with 'customer.' ? 'is-active' : '' }}"
      href="{{ link('profile') }}"
      aria-label="حسابي">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>حسابي</span>
    </a>
  {% else %}
    <button
      class="mobile-toolbar__item"
      type="button"
      aria-label="تسجيل الدخول"
      onclick="salla.event.dispatch('login::open')">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>حسابي</span>
    </button>
  {% endif %}

  <button
    class="mobile-toolbar__item"
    type="button"
    aria-label="البحث"
    onclick="salla.event.dispatch('search::open')">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>البحث</span>
  </button>
</nav>
