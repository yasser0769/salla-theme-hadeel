{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header class="store-header">
  {% set announcement_text = theme.settings.get('announcement_text', '')|trim %}
  {% if theme.settings.get('announcement_enabled', true) and announcement_text %}
  <div class="announcement-bar announcement-bar--{{ theme.settings.get('announcement_style', 'primary') }}">
    <div class="container announcement-bar__inner">
      {% if theme.settings.get('announcement_show_icon', true) %}
        <i class="sicon-shipping-fast {{ theme.is_rtl ? 'flip-x':'' }}" aria-hidden="true"></i>
      {% endif %}
      <span>{{ announcement_text }}</span>
    </div>
  </div>
  {% endif %}

  <div id="mainnav" class="main-nav-container">
    <div class="inner">
      <div class="container">
        <div class="main-nav-shell">
          <div class="main-nav-shell__menu">
            <a class="mobile-menu-trigger" href="#mobile-menu" aria-label="{{ trans('blocks.header.open_menu') }}">
              <i class="sicon-menu" aria-hidden="true"></i>
            </a>
            <custom-main-menu></custom-main-menu>
          </div>

          <a class="navbar-brand" href="{{ store.url }}">
            <img fetchpriority="high" width="175" height="64" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}">
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          {# Kalles-style utility rail; native Salla actions and counters remain intact. #}
          <div class="header-actions">
            <button class="header-action header-action--search" type="button" aria-label="{{ trans('blocks.header.search') }}" onclick="salla.event.dispatch('search::open')">
              <svg class="header-icon header-icon--search" aria-hidden="true" viewBox="0 0 32 32" focusable="false">
                <path d="M31.707 30.282l-9.716-9.776a12.45 12.45 0 1 0-1.401 1.426l9.703 9.764a1 1 0 0 0 1.414-1.414zM12.393 23.017A10.517 10.517 0 1 1 22.91 12.5a10.53 10.53 0 0 1-10.517 10.517z"></path>
              </svg>
            </button>
            {% if theme.settings.get('header_show_wishlist', true) %}
              <a class="header-action header-action--wishlist" href="{{ link('wishlist') }}" aria-label="{{ trans('blocks.header.wishlist') }}">
                <svg class="header-icon header-icon--wishlist" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </a>
            {% endif %}
            {% if user.type == 'user' %}
              <salla-user-menu class="header-user-menu" avatar-only show-header></salla-user-menu>
            {% else %}
              <button class="header-action header-action--account" type="button" aria-label="{{ trans('blocks.header.login') }}" onclick="salla.event.dispatch('login::open')">
                <svg class="header-icon header-icon--account" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </button>
            {% endif %}
            <salla-cart-summary class="header-cart">
              <svg slot="icon" class="header-icon header-icon--cart" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39A2 2 0 0 0 9.68 16h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </salla-cart-summary>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
    <salla-localization-modal></salla-localization-modal>
  {% endif %}
</header>
