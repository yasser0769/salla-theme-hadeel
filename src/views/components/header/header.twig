{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header class="store-header">
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      <i class="sicon-shipping-fast {{ theme.is_rtl ? 'flip-x':'' }}" aria-hidden="true"></i>
      <span>شحن مجاني للطلبات فوق ٤٥٠ ر.س</span>
    </div>
  </div>

  <div id="mainnav" class="main-nav-container">
    <div class="inner">
      <div class="container">
        <div class="main-nav-shell">
          <div class="main-nav-shell__menu">
            <a class="mobile-menu-trigger" href="#mobile-menu" aria-label="فتح القائمة">
              <i class="sicon-menu" aria-hidden="true"></i>
            </a>
            <custom-main-menu></custom-main-menu>
          </div>

          <a class="navbar-brand" href="{{ store.url }}">
            <img fetchpriority="high" width="175" height="64" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}">
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          <div class="header-actions">
            <button class="header-action header-action--search" type="button" aria-label="البحث" onclick="salla.event.dispatch('search::open')">
              <i class="sicon-search" aria-hidden="true"></i>
            </button>
            <a class="header-action header-action--wishlist" href="{{ link('wishlist') }}" aria-label="المفضلة">
              <i class="sicon-heart" aria-hidden="true"></i>
            </a>
            {% if user.type == 'user' %}
              <salla-user-menu avatar-only show-header></salla-user-menu>
            {% else %}
              <button class="header-action header-action--account" type="button" aria-label="تسجيل الدخول" onclick="salla.event.dispatch('login::open')">
                <i class="sicon-user-circle" aria-hidden="true"></i>
              </button>
            {% endif %}
            <salla-cart-summary class="header-cart">
              <i slot="icon" class="sicon-shopping-bag" aria-hidden="true"></i>
            </salla-cart-summary>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
    <salla-localization-modal></salla-localization-modal>
  {% endif %}
</header>
