{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| category                   | ?Category   |                                                                      |
| filters                    | bool        | is filters allowed here or not                                      |
| sort_options[]             | SortList[]  |                                                                      |
#}
{% extends "layouts.master" %}

{% block content %}
    <section class="collection-page"
             data-collection-page
             data-grid-density="auto">
        {% if category %}
            <header class="collection-hero {{ category.image ? 'collection-hero--image' : 'collection-hero--plain' }}">
                {% if category.image %}
                    <img class="collection-hero__image"
                         src="{{ category.image }}"
                         alt=""
                         fetchpriority="high">
                {% endif %}
                <div class="collection-hero__overlay" aria-hidden="true"></div>
                <div class="collection-hero__content">
                    <h1>{{ category.name }}</h1>
                    {% if theme.settings.get('product_index_show_breadcrumbs', true) %}
                        <nav class="collection-hero__breadcrumb breadcrumbs">
                            <salla-breadcrumb></salla-breadcrumb>
                        </nav>
                    {% endif %}
                </div>
            </header>

        {% else %}
            <header class="collection-heading collection-container">
                {% if theme.settings.get('product_index_show_breadcrumbs', true) %}
                    <nav class="collection-heading__breadcrumb breadcrumbs">
                        <salla-breadcrumb></salla-breadcrumb>
                    </nav>
                {% endif %}
                <h1>{{ page.title|raw }}</h1>
            </header>
        {% endif %}

        {#
        Category page components selected by the merchant are injected here.
        Salla persists each component instance for all categories or one selected category.
        #}
        <div class="s-blocks-wrapper s-before-products-list">
            {% hook 'product.index.before_products_group_with_filter' %}
        </div>

        <div class="collection-container collection-content">
            <div class="collection-toolbar" data-collection-toolbar>
                <div class="collection-toolbar__sort">
                    {% if sort_options|length %}
                        <label class="sr-only" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
                        <i class="sicon-keyboard_arrow_down" aria-hidden="true"></i>
                        <select id="product-filter" class="form-input" aria-label="{{ trans('pages.categories.sorting') }}">
                            {% for sort in sort_options %}
                                <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>

                <div class="collection-toolbar__density" role="group" aria-label="{{ trans('pages.products.kalles.display_density') }}">
                    <button type="button" data-grid-density="list" aria-label="{{ trans('pages.products.kalles.view_list') }}" aria-pressed="false">
                        <span class="density-icon density-icon--list" aria-hidden="true"></span>
                    </button>
                    <button type="button" data-grid-density="2" aria-label="{{ trans('pages.products.kalles.grid_two') }}" aria-pressed="false">
                        <span class="density-icon density-icon--2" aria-hidden="true"></span>
                    </button>
                    <button type="button" data-grid-density="3" aria-label="{{ trans('pages.products.kalles.grid_three') }}" aria-pressed="false">
                        <span class="density-icon density-icon--3" aria-hidden="true"></span>
                    </button>
                    <button type="button" data-grid-density="4" aria-label="{{ trans('pages.products.kalles.grid_four') }}" aria-pressed="false">
                        <span class="density-icon density-icon--4" aria-hidden="true"></span>
                    </button>
                </div>

                {% if filters %}
                    <button class="collection-toolbar__filter"
                            type="button"
                            data-collection-filter-trigger
                            aria-controls="collection-filters-drawer"
                            aria-label="{{ trans('pages.products.kalles.open_filters') }}">
                        <i class="sicon-filter" aria-hidden="true"></i>
                        <span>{{ trans('pages.products.kalles.filters') }}</span>
                    </button>
                {% endif %}
            </div>

            <p class="collection-results-summary" data-products-summary aria-live="polite"></p>

            {% hook 'product:index.items.start' %}
            <salla-products-list
                    class="collection-products"
                    data-collection-products
                    source="{{ page.slug }}"
                    source-value="{{ page.id }}"
                    {{ filters ? 'filters-results' : '' }}>
            </salla-products-list>
            {% hook 'product:index.items.end' %}
        </div>

        <div class="s-blocks-wrapper s-after-products-list">
            {% hook 'product.index.after_products_group_with_filter' %}
        </div>

        {% if filters %}
            <salla-drawer id="collection-filters-drawer"
                          class="collection-filters-drawer"
                          data-collection-filters-drawer
                          drawer-title="{{ trans('pages.products.kalles.filters') }}"
                          position="{{ theme.is_rtl ? 'right' : 'left' }}"
                          no-padding>
                <div class="collection-filters" data-collection-filters>
                    <salla-filters id="filters-menu"></salla-filters>
                </div>
            </salla-drawer>
        {% endif %}
    </section>

    {% if store.settings.category.testimonial_enabled %}
        {% component 'home.testimonials' %}
    {% endif %}

    <div class="s-blocks-wrapper s-after-testimonials">
        {% hook 'product.index.after_testimonials' %}
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
