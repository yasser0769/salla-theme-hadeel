{# Hadeel product route template; keep this file tracked explicitly for Salla branch sync.
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    {% set product_desc = product.description|replace({"&nbsp;":" "}) %}
    {% set compact_desc = product.subtitle ? product.subtitle : product_desc|striptags|replace({"\n":" ", "\r":" "})|trim %}
    <div class="kalles-product-page">
        {% if theme.settings.get('product_show_breadcrumbs', true) %}
            <div class="kalles-product-breadcrumb">
                <nav class="breadcrumbs container w-full">
                    <salla-breadcrumb></salla-breadcrumb>
                </nav>
            </div>
        {% endif %}

        <div class="container">
        <div class="kalles-product-overview" id="product-{{ product.id }}">
            <div class="sidebar kalles-product-gallery">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider {{ has_many_images ? 'has-multiple-images' : 'has-single-image' }}"
                        type="thumbs"
                        vertical-thumbs
                        pagination
                        loop="false"
                        listen-to-thumbnails-option
                        show-thumbs-controls="false">
                    {% if product.is_on_sale and product.discount_percentage %}
                        <div class="kalles-product-discount hidden"
                             data-discount-percent
                             dir="ltr"
                             aria-label="{{ trans('pages.products.kalles.discount') }}">
                            {{ product.discount_percentage }}
                        </div>
                    {% elseif product.promotion_title %}
                        <div class="promotion-title">{{ product.promotion_title }}</div>
                    {% endif %}

                    {# The wishlist control lives once, in the purchase tools below. #}

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images %}
                        <div slot="thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    {% if loop.index < 5 %}
                                        <img src="{{ image.url }}"
                                             loading="eager"
                                             class="object-cover w-full h-full bg-gray-100 rounded-md overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% else %}
                                        <img src="{{ image.url }}"
                                             loading="lazy"
                                             class="object-cover w-full h-full bg-gray-100 rounded-md overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            <div class="main-content kalles-product-summary">

                {% hook 'product:single.description.start' %}

                {% if product.brand.name %}
                    <div class="product-brand kalles-product-brand mb-5 w-12">
                        <a class="brand-logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            <img width="100%" height="100%" class="max-h-full object-contain"
                                 src="{{ product.brand.logo }}"
                                 title="{{ product.brand.name }}"
                                 alt="{{ product.brand.name }}">
                        </a>
                    </div>
                {% endif %}

                {% if product.promotion_title %}
                    <p class="kalles-product-kicker">{{ product.promotion_title }}</p>
                {% endif %}

                <h1 class="kalles-product-title text-xl md:text-2xl leading-10 font-bold mb-6 text-gray-800">{{ product.name }}</h1>

                {% if product.rating or product.is_taxable %}
                <div class="kalles-product-rating">
                    {% if product.rating %}
                        <salla-rating-stars value="{{ product.rating.stars }}"
                                            reviews="{{ product.rating.count }}"></salla-rating-stars>
                    {% endif %}

                    {% if product.is_taxable %}
                        <small class="color-grey">{{ trans('pages.products.tax_included') }}</small>
                    {% endif %}
                </div>
                {% endif %}

                {# Price #}
                <div class="kalles-product-price price-wrapper"
                     data-product-pricing
                     data-is-on-sale="{{ product.is_on_sale ? 'true' : 'false' }}"
                     data-regular-price="{{ product.regular_price }}"
                     data-sale-price="{{ product.sale_price }}">
                    <div class="kalles-product-sale-price price_is_on_sale {{ product.is_on_sale ? 'flex' : 'hidden' }}">
                        <p class="total-price">{{ product.sale_price|money }}</p>
                        <span class="before-price">{{ product.regular_price|money }}</span>
                        <span class="kalles-product-saving hidden">
                            {{ trans('pages.products.kalles.save') }}
                            <span data-saving-value></span>
                        </span>
                    </div>
                    <div class="kalles-product-normal-price starting-or-normal-price {{ product.is_on_sale ? 'hidden' : 'flex' }}">
                        {% if product.starting_price %}
                            <span class="starting-price-title">{{ trans('pages.products.starting_price') }}</span>
                        {% endif %}
                        <p class="total-price">{{ product.starting_price ? product.starting_price|money : product.price|money }}</p>
                    </div>
                </div>

                {% if compact_desc %}
                    <div class="product__description kalles-product-description">
                        <p>{{ compact_desc|slice(0, 230) }}{{ compact_desc|length > 230 ? '…' : '' }}</p>
                        {% if product.description %}
                            <a href="#product-details" class="kalles-product-details-link">
                                {{ trans('pages.products.read_more') }}
                                <i class="sicon-keyboard_arrow_down" aria-hidden="true"></i>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                <form class="form product-form kalles-product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">


                    {% hook 'product:single.form.start' %}

                    {% include 'pages.partials.product.options' %}

                    {% hook 'product:single.form.end' %}

                    <div class="out-of-stock min-h-7 leading-7 hidden text-base text-red-600 !opacity-50 font-bold">
                        {{ trans('pages.products.out_of_stock') }}
                    </div>

                    {# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    {% set show_installment_tamara = theme.settings.get('product_installment_show_tamara', true) %}
                    {% set show_installment_tabby = theme.settings.get('product_installment_show_tabby', true) %}
                    {% set show_installment_mispay = theme.settings.get('product_installment_show_mispay', true) %}
                    {% set installment_price = product.is_on_sale
                        ? product.sale_price
                        : (product.starting_price ? product.starting_price : product.price) %}
                    {% if show_installment_tamara or show_installment_tabby or show_installment_mispay %}
                        <section class="hadeel-installments" data-hadeel-installments>
                            <div class="hadeel-installments__bar" data-installment-bar hidden>
                                <span class="hadeel-installments__prompt">
                                    {{ trans('pages.products.kalles.installment_prompt') }}
                                </span>
                                <div class="hadeel-installments__providers">
                                    {% if show_installment_tamara %}
                                        <button class="hadeel-installments__provider"
                                                type="button"
                                                data-installment-provider="tamara"
                                                aria-label="{{ trans('pages.products.kalles.installment_tamara_info') }}"
                                                hidden disabled>
                                            <i class="sicon-info" aria-hidden="true"></i>
                                            <span class="hadeel-installments__brand">
                                                {{ trans('pages.products.kalles.installment_tamara') }}
                                            </span>
                                        </button>
                                    {% endif %}
                                    {% if show_installment_tabby %}
                                        <button class="hadeel-installments__provider"
                                                type="button"
                                                data-installment-provider="tabby"
                                                aria-label="{{ trans('pages.products.kalles.installment_tabby_info') }}"
                                                hidden disabled>
                                            <i class="sicon-info" aria-hidden="true"></i>
                                            <span class="hadeel-installments__brand">
                                                {{ trans('pages.products.kalles.installment_tabby') }}
                                            </span>
                                        </button>
                                    {% endif %}
                                    {% if show_installment_mispay %}
                                        <button class="hadeel-installments__provider"
                                                type="button"
                                                data-installment-provider="mispay"
                                                aria-label="{{ trans('pages.products.kalles.installment_mispay_info') }}"
                                                hidden disabled>
                                            <i class="sicon-info" aria-hidden="true"></i>
                                            <span class="hadeel-installments__brand">
                                                {{ trans('pages.products.kalles.installment_mispay') }}
                                            </span>
                                        </button>
                                    {% endif %}
                                </div>
                            </div>

                            {#
                              Salla owns provider eligibility, pricing, scripts, and explanation
                              dialogs. Keep the native component mounted and let the compact buttons
                              invoke its real provider triggers instead of duplicating that logic.
                            #}
                            <div class="hadeel-installments__native" aria-hidden="true">
                                <salla-installment price="{{ installment_price }}"></salla-installment>
                            </div>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar kalles-product-purchase bg-white p-5 rounded-md rounded-b-none">
                        {# Add to cart #}
                        <salla-add-product-button
                                {{theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : ''}}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                data-add-to-cart-animation="{{ theme.settings.get('product_add_to_cart_animation', 'tada') }}"
                                data-add-to-cart-animation-interval="{{ theme.settings.get('product_add_to_cart_animation_interval', 6) }}"
                                amount="{{ product.base_currency_price }}"
                                class="mt-5 w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {# Notify availability props#}
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>

                            {{ product.add_to_cart_label }}
                        </salla-add-product-button>

                        {# Quantity #}
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity" aria-label="{{ trans('pages.products.quantity') }}"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity">
                                <label class="sr-only" for="product-quantity-{{ product.id }}">
                                    {{ trans('pages.products.quantity') }}
                                </label>
                                <salla-quantity-input
                                        id="product-quantity-{{ product.id }}"
                                        max="{{ product.max_quantity }}"
                                        value="1"
                                        name="quantity"
                                        aria-label="{{ trans('pages.products.quantity') }}">
                                </salla-quantity-input>
                            </div>
                        {% endif %}

                        {% if theme.settings.get('product_show_wishlist', true) %}
                            <div class="kalles-product-purchase-tools" aria-label="{{ trans('pages.products.kalles.product_tools') }}">
                                <salla-button
                                        class="kalles-wishlist-action btn--wishlist animated"
                                        data-id="{{ product.id }}"
                                        onclick="salla.wishlist.toggle('{{ product.id }}')"
                                        type="button"
                                        shape="icon"
                                        fill="outline"
                                        color="light"
                                        aria-label="{{ trans('pages.products.kalles.add_to_wishlist') }}">
                                    <i class="sicon-heart" aria-hidden="true"></i>
                                </salla-button>
                                {# Sharing lives once, in the .kalles-product-share row below. #}
                            </div>
                        {% endif %}
                    </section>
                    {% if product.is_giftable %}
                        <salla-gifting class="mt-5" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : ''  }}></salla-gifting>
                    {% endif %}
                </form>

                <salla-trust-badges class="kalles-product-trust"></salla-trust-badges>

                {% if product.has_size_guide or (product.is_require_shipping and product.description) or store.contacts.whatsapp or store.contacts.email %}
                <div class="kalles-product-support-links">
                    {% if product.has_size_guide %}
                        <div class="kalles-product-support-item">
                            <salla-button
                                    class="kalles-size-guide-action"
                                    type="button"
                                    shape="link"
                                    color="dark"
                                    onclick="salla.event.dispatch('size-guide::open', '{{ product.id }}')">
                                <i class="sicon-pencil-ruler" aria-hidden="true"></i>
                                <span>{{ trans('pages.products.size_guides') }}</span>
                            </salla-button>
                            <salla-product-size-guide></salla-product-size-guide>
                        </div>
                    {% endif %}

                    {% if product.is_require_shipping and product.description %}
                        <a class="kalles-product-delivery" href="#product-details">
                            <i class="sicon-shipping-fast" aria-hidden="true"></i>
                            <span>{{ trans('pages.products.kalles.delivery_returns') }}</span>
                        </a>
                    {% endif %}

                    {% if store.contacts.whatsapp %}
                        {% set whatsapp_number = store.contacts.whatsapp|replace({' ': '', '+': '', '-': ''}) %}
                        {% set whatsapp_message = (trans('pages.products.kalles.whatsapp_inquiry') ~ ' ' ~ product.name ~ ' - ' ~ product.url)|url_encode %}
                        <a class="kalles-ask-product"
                           href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message }}"
                           target="_blank"
                           rel="noopener">
                            <i class="sicon-chat-conversation-alt" aria-hidden="true"></i>
                            <span>{{ trans('pages.products.kalles.ask_question') }}</span>
                        </a>
                    {% elseif store.contacts.email %}
                        {% set email_subject = (trans('pages.products.kalles.email_inquiry') ~ ' ' ~ product.name)|url_encode %}
                        <a class="kalles-ask-product"
                           href="mailto:{{ store.contacts.email }}?subject={{ email_subject }}">
                            <i class="sicon-mail" aria-hidden="true"></i>
                            <span>{{ trans('pages.products.kalles.ask_question') }}</span>
                        </a>
                    {% endif %}
                </div>
                {% endif %}

                <dl class="kalles-product-meta">
                    <div>
                        <dt>{{ trans('pages.products.kalles.availability') }}:</dt>
                        <dd class="{{ product.is_available ? 'is-available' : 'is-unavailable' }}">
                            {{ product.is_available ? trans('pages.products.kalles.in_stock') : trans('pages.products.out_of_stock') }}
                        </dd>
                    </div>

                    {% if product.sku %}
                        <div>
                            <dt>{{ trans('pages.products.sku') }}:</dt>
                            <dd class="text-unicode">{{ product.sku }}</dd>
                        </div>
                    {% endif %}

                    {% if product.category %}
                        <div>
                            <dt>{{ trans('pages.products.kalles.category') }}:</dt>
                            <dd><a href="{{ product.category.url }}">{{ product.category.name }}</a></dd>
                        </div>
                    {% endif %}

                    {% if product.tags|length and theme.settings.get('show_tags', true) %}
                        <div>
                            <dt>{{ trans('pages.products.kalles.tags') }}:</dt>
                            <dd>
                                {% for tag in product.tags %}
                                    <a href="{{ tag.url }}">{{ tag.name }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </dd>
                        </div>
                    {% endif %}
                </dl>

                <div class="kalles-product-share">
                    <span>{{ trans('pages.products.kalles.share') }}</span>
                    <salla-social-share aria-label="{{ trans('pages.products.kalles.share') }}"></salla-social-share>
                </div>

                {% if product.sold_quantity or product.can_show_remained_quantity %}
                    <div class="kalles-product-demand bg-white py-2.5 mb-5 rounded-md inline-flex text-sm">
                        {% if product.sold_quantity %}
                            <div class="px-4 !text-red-800">
                                <i class="sicon-fire rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div class="px-4 rtl:even:border-r ltr:even:border-l even:border-gray-200">
                                <i class="!text-red-800 sicon-box-bankers rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% hook 'product:single.description' %}

                {% if product.show_availability %}
                    <section class="bg-white p-5 rounded-md mb-5 last:mb-0">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <a href="#!"
                                   onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                   class="group text-primary flex items-center justify-center">
                                    <span>{{ trans('pages.products.select_branch') }}</span>
                                    <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                </a>
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% if product.digital_files_settings %}
                    <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                {% endif %}

                {% hook 'product:single.description.end' %}
                <salla-quick-order class="mt-5 md:-mb-2 block"></salla-quick-order>
            </div>
        </div>

        {% if product.has_metadata %}
            <section class="kalles-product-native-meta">
                <salla-metadata></salla-metadata>
            </section>
        {% endif %}

        {% if product.description %}
            <section id="product-details" class="kalles-product-details">
                <h2>{{ trans('pages.products.kalles.product_details') }}</h2>
                <article class="article article--main">
                    {{ product_desc|raw }}
                </article>
            </section>
        {% endif %}

        <div class="kalles-product-offers">
            <salla-offer></salla-offer>
        </div>
        </div>
    </div>

    {# Comments Area #}
    {% if store.settings.rating.show_on_product %}
        <div class="kalles-product-comments">
            <salla-comments item-id="{{product.id}}" type="product"></salla-comments>
        </div>
    {% endif %}
    
    {# Similar Products Area #}
    <div class="container kalles-related-products" data-related-products hidden>
        <salla-products-slider source="related" source-value="{{product.id}}" block-title="{{trans('pages.products.similar_products')}}" display-all-url></salla-products-slider>
    </div>

{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer@4.3.1/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
